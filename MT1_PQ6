package src;

class Node8
{
	int data;
	Node8 prev;
	Node8 next;
}

class Solution8
{
	public static Node8 insertionSort(Node8 head)
	{
		Node8 currentI = head.next;
		
		while(currentI != null)
		{
			Node8 currentJ = currentI;
			
			while(currentJ.prev != null && currentJ.data < currentJ.prev.data)
			{
				int temporary = currentJ.data;
				
				currentJ.data = currentJ.prev.data;
				currentJ.prev.data = temporary;
				
				currentJ = currentJ.prev;
			}
			
			currentI = currentI.next;
		}
		
		return head;
	}
}

