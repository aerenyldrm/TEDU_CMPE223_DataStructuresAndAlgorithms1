package src;

class Node4
{
	int data;
	Node4 next; 
}

class Solution4
{
	public static void teduDelete(int x, int y, Node4 head) // remove y nodes in every x nodes
	{
		int counterX = x;
		int counterY = y;
		
		Node4 current = head;
		
		while(current != null)
		{
			Node4 nextNode = current.next;
			
			if(counterX == 1)
			{
				while(counterY > 0 && nextNode != null)
				{
					nextNode = nextNode.next;
					counterY--;
				}
				
				counterX = x;
				counterY = y;
			}
			else
			{
				counterX--;
			}
			
			current.next = nextNode;
			
			current = nextNode;
		}
	}
}

