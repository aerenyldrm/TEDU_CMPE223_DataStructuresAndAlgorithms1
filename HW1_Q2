import java.util.Scanner;

/*
I pursued Leetcode resembling logic while writing code.
I constructed an array-based stack class i.e., FixedCapacityStackOfIntegers class that includes core definitions for a stack including isEmpty(), push(), and pop().
And I added peek() functionality which is further included in built-in Stack class in Java.
Essentially, I defined this class by considering course textbook and slides.
I wanted to define it custom, becausei I wanted to uunderstand exactly what it is going on.
Of course this problem is solvable by utilizing built-in Stack class in Java.
Afterwards, I constructed solution class includes required functions and attributes to do job.
*/

class FixedCapacityStackOfIntegers
{
    private int[] i;
    private int n = 0;
    
    FixedCapacityStackOfIntegers(int capacity)
    {
        i = new int[capacity];
    }
    
    public boolean isEmpty()
    {
        return n == 0;
    }
    
    public void push(int item)
    {
        i[n++] = item;
    }
    
    public int pop()
    {
        return i[--n];
    }
    
    public int peek()
    {
    	return i[n - 1];
    }
}

/*
HIGH LEVEL PSEUDOCODE
pursue a 2-stack approach
a stack is for fun scores and other stack is for minimum fun scores until or within that fragment of time
*/

/*
LOW LEVEL PSEUDOCODE
keep track of minimum at that instant of time -> a dummy value that is maximum possible integer in java is assigned initially to get rid of extra if conditions
in case of adding operation
	push relevant value to stack of fun scores
	if value is less than or equal to current minimum
		update minimum as this value and push this value to stack of minimum fun scores
in case of deleting operation
	if stack of fun scores is empty
		print that it is empty on screen
	else
		pop stack of fun scores from top
		if it is equal to top of stack of minimum fun scores
			pop stack of minimum fun scores
			update minimum as peek of final stack of minimum fun scores from top
in case of minimum operation
	if stack of fun scores is empty
		print that it is empty on screen
	else
		print minimum
*/

class Solution
{
    int minimum = Integer.MAX_VALUE; //assign a dummy value to get rid of extra conditions
    
    public void question2Add(FixedCapacityStackOfIntegers stackOfFunScores, FixedCapacityStackOfIntegers stackOfMinimumScores, int value)
    {
        stackOfFunScores.push(value);
        
        if(value <= this.minimum)
        {
            this.minimum = value;
            
            stackOfMinimumScores.push(value);
        }
    }
    
    public void question2Del(FixedCapacityStackOfIntegers stackOfFunScores, FixedCapacityStackOfIntegers stackOfMinimumScores)
    {
    	if(stackOfFunScores.isEmpty())
    	{
    		System.out.println("Empty");
    	}
    	else
    	{
	    	int currentFunScore = stackOfFunScores.pop();
	    	
	    	if(currentFunScore == this.minimum)
	    	{
	    		stackOfMinimumScores.pop();
	    		
	    		if(!stackOfMinimumScores.isEmpty()) // after final pop there is a probability that stack of minimum fun scores is empty so peek() is meaningless
	    		{
	    			this.minimum = stackOfMinimumScores.peek();
	    		}
	    	}
    	}
    }
    
    public void question2Min(FixedCapacityStackOfIntegers stackOfFunScores)
    {
    	if(stackOfFunScores.isEmpty())
    	{
    		System.out.println("Empty");
    	}
    	else
    	{
    		System.out.println(this.minimum);
    	}
    }
}

public class HW1_Q2
{
	public static void main(String[] args)
	{
        Scanner scanner  = new Scanner(System.in);		
		Solution solution = new Solution();
        String stringOperationCount = scanner.nextLine();
        int operationCount = Integer.parseInt(stringOperationCount);
        
        FixedCapacityStackOfIntegers stackOfFunScores = new FixedCapacityStackOfIntegers(operationCount);
        FixedCapacityStackOfIntegers stackOfMinimumScores = new FixedCapacityStackOfIntegers(operationCount);
        
        for(int i = 0; i < operationCount; i++)
        {
        	String line = scanner.nextLine();
        	String[] subparts = line.split(" ");
        	
        	if(subparts[0].equals("ADD"))
        	{
        		int value = Integer.parseInt(subparts[1]);
        		solution.question2Add(stackOfFunScores, stackOfMinimumScores, value);
        	}
        	
        	else if(subparts[0].equals("DEL"))
        	{
        		solution.question2Del(stackOfFunScores, stackOfMinimumScores);
        	}
        	else if(subparts[0].equals("MIN"))
        	{
        		solution.question2Min(stackOfFunScores);
        	}
        }
        
        scanner.close();
	}
}
