package src;

class Solution7
{
	static void sort(int[] arr)
	{
		for(int i = (arr.length - 1) - 1; i >= 0; i--)
		{
			int j = i;
			
			while(j < (arr.length - 1) && arr[j] < arr[j + 1])
			{
				int temporary = arr[j];
				
				arr[j] = arr[j + 1];
				arr[j + 1] = temporary;
				
				j++;
			}
		}
	}
}

public class PracticeQuestion7
{
	public static void main(String[] args)
	{
		int[] arr = {4, 1, 3, 9, 7};
		
		Solution7.sort(arr);
		
		for(int integer : arr)
		{
			System.out.print(integer + " ");
		}
	}
}
