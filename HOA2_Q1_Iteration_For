class Node
{
    private int element;
    private Node next;
    
    Node(int element, Node next)
    {
        this.element = element;
        this.next = next;
    }
    
    public int getElement() { return this.element; }
    public Node getNext() { return this.next; }
    
    public void setElement(int element) { this.element = element; }
    public void setNext(Node next) { this.next = next; }
}

class SLinkedList
{
    private Node head;
    private long size;
    
    SLinkedList(Node head, long size)
    {
        this.head = head;
        this.size = size;
    }
    
    public Node getHead() { return this.head; }
    public long getSize() { return this.size; }
    
    public void setHead(Node head) { this.head = head; }
    public void setSize(long size) { this.size = size; }
    
    public int sum() // by iteration concept with for loop
    {
        int sum = 0;
        Node theNode = this.head;
        
        for(int counter = 0; counter < size; counter++)
        {
            sum += theNode.getElement();
            theNode = theNode.getNext();
        }
        
        return sum;
    }
}

public class Main 
{
    public static void main() // test with multiple values
    {
        Node n5 = new Node(5, null);
        Node n4 = new Node(4, n5);
        Node n3 = new Node(3, n4);
        Node n2 = new Node(2, n3);
        Node n1 = new Node(1, n2);
            
        SLinkedList list = new SLinkedList(n1, 5);
        
        System.out.println(list.sum());
        
        SLinkedList listSingle = new SLinkedList(new Node(1, null), 1);
        
        System.out.println(listSingle.sum());
        
        SLinkedList listEmpty = new SLinkedList(null, 0);
        
        System.out.println(listEmpty.sum());
    }
}
