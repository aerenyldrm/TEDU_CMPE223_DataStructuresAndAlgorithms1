package src;

class Node2
{
	int data;
	Node2 next; 
}

class SLinkedList
{
	Node2 head;
	
	void skippify()
	{
		Node2 n = head;
		
		int incr = 1;
		
		while(n != null)
		{
			Node2 nextNode = n.next;
			
			for(int i = 0; i <= incr; i++)
			{
				if(i == incr || nextNode == null)
				{
					break;
				}
				
				nextNode = nextNode.next;
			}
			
			n.next = nextNode;
			n = n.next;
			incr++;
		}
	}
}

