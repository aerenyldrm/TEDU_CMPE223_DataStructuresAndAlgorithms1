package src;

class Solution6
{
	static void selectionSortOther(int[] arr) // descending order from right to left
	{
		for(int i = arr.length - 1; i >= 0; i--)
		{
			int minimum = i;
			
			for(int j = i - 1; j >= 0; j--)
			{
				if(arr[j] < arr[minimum])
				{
					minimum = j;
				}
			}
			
			int temporary = arr[i];
			
			arr[i] = arr[minimum];
			arr[minimum] = temporary;
		}
	}
}

public class PracticeQuestion6
{
	public static void main(String[] args)
	{
		int[] arr = {4, 1, 3, 9, 7};
		
		Solution6.selectionSortOther(arr);
		
		for(int integer : arr)
		{
			System.out.print(integer + " ");
		}
	}
}
